{
  "info": {
    "_postman_id": "b8a1c9e4-7123-4f52-9c16-03b20ebc6f59",
    "name": "Barangay Bugo Resident Assistance API Test Suite",
    "description": "Automated Quality Assurance and API Test Suite for Barangay Bugo Resident Assistance Management System (Capstone Final Defense Verification).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": ["{{base_url}}"],
          "path": ["api", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"System health status is 'ok'\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"ok\");",
              "});",
              "pm.test(\"Response time is under 500ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Admin Authentication (Valid Credentials)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@bugo.gov.ph\",\n  \"password\": \"Admin@Bugo2026!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Login successful with role 'admin'\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.user.role).to.eql(\"admin\");",
              "    pm.expect(jsonData.user.email).to.eql(\"admin@bugo.gov.ph\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Resident Authentication (Valid Credentials)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"resident@bugo.gov.ph\",\n  \"password\": \"Resident@Bugo2026!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Login successful with role 'resident'\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.user.role).to.eql(\"resident\");",
              "    pm.expect(jsonData.user.residentIdNumber).to.eql(\"BG-2026-04829\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Security Check - Reject Invalid Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@bugo.gov.ph\",\n  \"password\": \"IncorrectPassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test(\"Returns authentication failure message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.false;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Data Sanitization & 28+ Services Verification",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/data",
          "host": ["{{base_url}}"],
          "path": ["api", "data"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"All 28+ active services are returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.programs.length).to.be.at.least(28);",
              "});",
              "pm.test(\"Security Check: Password hashes are never exposed in public data\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.users.forEach(function(user) {",
              "        pm.expect(user.passwordHash).to.be.undefined;",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. MySQL Schema & DDL Export Verification",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/database/export-sql",
          "host": ["{{base_url}}"],
          "path": ["api", "database", "export-sql"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Content-Type contains application/sql\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"sql\");",
              "});",
              "pm.test(\"SQL dump contains barangay_bugo_db definitions\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"barangay_bugo_db\");",
              "    pm.expect(pm.response.text()).to.include(\"ENGINE=InnoDB\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. MySQL Diagnostic Metadata",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/database/mysql-info",
          "host": ["{{base_url}}"],
          "path": ["api", "database", "mysql-info"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returns 8 MySQL relational tables metadata\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.tables.length).to.eql(8);",
              "    pm.expect(jsonData.characterSet).to.eql(\"utf8mb4\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8. Database Schema & ERD Inspection",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/database/schema",
          "host": ["{{base_url}}"],
          "path": ["api", "database", "schema"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returns 8 active tables and ERD relations\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.totalTables).to.eql(8);",
              "    pm.expect(jsonData.relations.length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "9. Deployment Readiness Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/deployment/status",
          "host": ["{{base_url}}"],
          "path": ["api", "deployment", "status"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Readiness checks array is present\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.readinessChecks.length).to.be.above(5);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
