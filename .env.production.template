# =========================================================================
# BARANGAY BUGO - PRODUCTION ENVIRONMENT VARIABLES (Render Deployment)
# =========================================================================
# Copy these to Render Dashboard → Environment Variables
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =========================================================================

# --- Runtime Environment ---
NODE_ENV=production
FORCE_HTTPS=true
LOG_LEVEL=info
PORT=                                    # Auto-injected by Render (do not set)

# --- Application URLs ---
# Replace with your actual Render service URL
APP_URL=https://your-service-name.onrender.com
CORS_ORIGIN=https://your-service-name.onrender.com

# --- Database Connection (MySQL 8.0+ with SSL) ---
# Format: mysql://username:password@host:port/database?sslaccept=strict
DATABASE_URL=mysql://username:password@host:3306/barangay_bugo_db?sslaccept=strict

# --- Authentication & Cryptographic Security ---
# Generate 64-character hex secrets using crypto.randomBytes(48).toString('hex')
JWT_SECRET=                              # REQUIRED: 64+ char random hex
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12
HMAC_SECRET=                             # REQUIRED: 64+ char random hex

# --- Initial Database Seeding ---
# Set strong passwords before first deployment, then rotate or remove
SEED_ADMIN_PASSWORD=                     # REQUIRED: Strong password (12+ chars)
SEED_RESIDENT_PASSWORD=                  # REQUIRED: Strong password (12+ chars)

# --- Optional AI ID Verification (Google Gemini) ---
GEMINI_API_KEY=                          # OPTIONAL: Leave empty to use heuristic fallback

# =========================================================================
# SECURITY NOTES:
# - Never commit this file with real values to Git
# - Rotate JWT_SECRET and HMAC_SECRET periodically
# - Change default admin password immediately after first login
# - Use ?sslaccept=strict in DATABASE_URL for production
# - Verify FORCE_HTTPS=true for HTTPS redirect
# =========================================================================
